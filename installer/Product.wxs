<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="HealthLOQ Document Hash Generator"
           Manufacturer="HealthLOQ"
           Version="1.1.0"
           UpgradeCode="A3F1C2D4-5E6F-7A8B-9C0D-E1F2A3B4C5D6"
           Compressed="yes">

    <MajorUpgrade
        AllowSameVersionUpgrades="yes"
        Schedule="afterInstallInitialize"
        DowngradeErrorMessage="A newer version of HealthLOQ Document Hash Generator is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Node.js prerequisite check -->
    <Launch Condition="Installed OR NODEJS_EXE"
            Message="Node.js must be installed before running this installer. Please install Node.js (v18 or newer) from https://nodejs.org and try again." />

    <!-- ═══════════════════════════════════════════════
         CONFIGURATION PROPERTIES
         ═══════════════════════════════════════════════ -->
    <Property Id="PORT" Value="8003" />
    <Property Id="DOCS_FOLDER" Value="C:\HealthLOQ Documents" />
    <Property Id="JWT_TOKEN" Secure="yes" />
    <Property Id="ALERT_EMAIL" Secure="yes" />

    <!-- Search for node.exe in common install path -->
    <Property Id="NODEJS_EXE">
      <DirectorySearch Id="NodeSearch1" Path="[WindowsVolume]Program Files\nodejs" Depth="0">
        <FileSearch Name="node.exe" />
      </DirectorySearch>
    </Property>

    <!-- ═══════════════════════════════════════════════
         PREFLIGHT CHECK PROPERTIES
         RunPreflight (immediate CA, Before="AppSearch") writes the
         display strings "[  OK  ]" or "[ FAIL ]" to HKCU.
         AppSearch reads them back; default is "[ FAIL ]" if the CA
         did not run or the registry key does not exist.
         ═══════════════════════════════════════════════ -->
    <Property Id="PREFLIGHT_NODE" Value="[ FAIL ]">
      <RegistrySearch Id="PF_Node" Root="HKCU"
                      Key="Software\HealthLOQ\HashGenerator\Preflight"
                      Name="NodeOK" Type="raw" />
    </Property>
    <Property Id="PREFLIGHT_PORT" Value="[ FAIL ]">
      <RegistrySearch Id="PF_Port" Root="HKCU"
                      Key="Software\HealthLOQ\HashGenerator\Preflight"
                      Name="PortOK" Type="raw" />
    </Property>
    <Property Id="PREFLIGHT_NETWORK" Value="[ FAIL ]">
      <RegistrySearch Id="PF_Network" Root="HKCU"
                      Key="Software\HealthLOQ\HashGenerator\Preflight"
                      Name="NetworkOK" Type="raw" />
    </Property>
    <Property Id="PREFLIGHT_DISK" Value="[ FAIL ]">
      <RegistrySearch Id="PF_Disk" Root="HKCU"
                      Key="Software\HealthLOQ\HashGenerator\Preflight"
                      Name="DiskOK" Type="raw" />
    </Property>
    <Property Id="PREFLIGHT_WINDOWS" Value="[ FAIL ]">
      <RegistrySearch Id="PF_Windows" Root="HKCU"
                      Key="Software\HealthLOQ\HashGenerator\Preflight"
                      Name="WindowsOK" Type="raw" />
    </Property>

    <!-- ═══════════════════════════════════════════════
         DIRECTORY STRUCTURE
         ═══════════════════════════════════════════════ -->
    <StandardDirectory Id="ProgramFilesFolder">
      <Directory Id="COMPANYDIR" Name="HealthLOQ">
        <Directory Id="INSTALLFOLDER" Name="HealthLOQ Document Hash" />
      </Directory>
    </StandardDirectory>

    <!-- ═══════════════════════════════════════════════
         FEATURES
         ═══════════════════════════════════════════════ -->
    <Feature Id="ProductFeature" Title="HealthLOQ Document Hash Generator" Level="1">
      <ComponentGroupRef Id="AppComponents" />
      <ComponentRef Id="DocsFolderTracker" />
    </Feature>

    <!-- ═══════════════════════════════════════════════
         CUSTOM ACTIONS
         RunPreflight: immediate type-50 CA (Property holds EXE path).
           Runs before AppSearch in the UISequence.  Cannot use
           Directory="SystemFolder" there because the Directory Manager
           is not yet initialized (error 2732).  Instead we use a
           SetProperty (type-51, no Directory Manager needed) to resolve
           [SystemFolder] into POWERSHELL_EXE, then reference that
           property as the executable.
           PREFLIGHT_B64 is injected by build-msi.ps1 via -d flag.
         RunInstallScript / RunUninstallScript: deferred (elevated).
           WiX formats [PROPERTY] refs at schedule time so Secure values
           are embedded before execution.  InstallDir via $PSScriptRoot.
         ═══════════════════════════════════════════════ -->

    <!-- Type-51 CA: sets POWERSHELL_EXE from a formatted string.
         [SystemFolder] is a standard MSI property available at startup
         (no Directory Manager needed).  Named so it can be an After= anchor. -->
    <CustomAction Id="SetPSPath"
                  Property="POWERSHELL_EXE"
                  Value="[SystemFolder]WindowsPowerShell\v1.0\powershell.exe" />

    <!-- Type-50 CA: Property="POWERSHELL_EXE" supplies the resolved exe path.
         No Directory attribute → no Directory Manager → no error 2732. -->
    <CustomAction Id="RunPreflight"
                  Execute="immediate"
                  Return="ignore"
                  Property="POWERSHELL_EXE"
                  ExeCommand="-NonInteractive -NoProfile -ExecutionPolicy Bypass -EncodedCommand $(var.PREFLIGHT_B64)" />

    <CustomAction Id="RunInstallScript"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check"
                  Directory="SystemFolder"
                  ExeCommand="&quot;[SystemFolder]WindowsPowerShell\v1.0\powershell.exe&quot; -NonInteractive -NoProfile -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]setup.ps1&quot; -Port &quot;[PORT]&quot; -DocsFolder &quot;[DOCS_FOLDER] &quot; -JwtToken &quot;[JWT_TOKEN]&quot; -AlertEmail &quot;[ALERT_EMAIL]&quot;" />

    <CustomAction Id="RunUninstallScript"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore"
                  Directory="SystemFolder"
                  ExeCommand="&quot;[SystemFolder]WindowsPowerShell\v1.0\powershell.exe&quot; -NonInteractive -NoProfile -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]teardown.ps1&quot;" />

    <!-- ═══════════════════════════════════════════════
         INSTALL SEQUENCES
         ═══════════════════════════════════════════════ -->
    <InstallUISequence>
      <!-- SetPSPath (type-51) resolves [SystemFolder] into POWERSHELL_EXE.
           RunPreflight (type-50) fires after, then AppSearch reads results. -->
      <Custom Action="SetPSPath"    Before="AppSearch" />
      <Custom Action="RunPreflight" After="SetPSPath" />
    </InstallUISequence>

    <InstallExecuteSequence>
      <Custom Action="RunInstallScript"   After="InstallFiles"      Condition="NOT Installed" />
      <Custom Action="RunUninstallScript" After="InstallInitialize" Condition="Installed AND REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>

    <!-- ═══════════════════════════════════════════════
         UI
         Dialog flow overrides must live in this file alongside ui:WixUI
         so WiX 4 merges them into the ControlEvent table correctly.
         ═══════════════════════════════════════════════ -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <ui:WixUI Id="WixUI_InstallDir" />
    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />

    <UI>
      <!-- WelcomeDlg: upgrade detected → upgrade info dialog -->
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog"
               Value="HLQUpgradeDlg"
               Condition="WIX_UPGRADE_DETECTED"
               Order="3" />

      <!-- WelcomeDlg: same version already installed → maintenance (Repair/Remove) -->
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog"
               Value="MaintenanceTypeDlg"
               Condition="Installed AND NOT PATCH"
               Order="2" />

      <!-- WelcomeDlg: fresh install → preflight check screen (Order=4 beats built-in) -->
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog"
               Value="HLQPreflightDlg"
               Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED"
               Order="4" />

      <!-- InstallDirDlg Next → HLQConfigDlg (Order=5 beats built-in Order=4) -->
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog"
               Value="HLQConfigDlg"
               Condition="WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID = &quot;1&quot;"
               Order="5" />

      <!-- VerifyReadyDlg Back → HLQAlertDlg (Order=5 beats built-in Order=1) -->
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog"
               Value="HLQAlertDlg"
               Condition="NOT Installed"
               Order="5" />
    </UI>

  </Package>

</Wix>
